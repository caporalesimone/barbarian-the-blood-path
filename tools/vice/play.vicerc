; Impostazioni aggiuntive di VICE per tools/vice/play.sh (14/11), caricate con -addconfig.
; Joystick 1 (porta 1) = keyset 1 sui tasti F13-F17, che nessun altro usa: sono quelli che manda l'overlay "Joy 1" di live.html.
; I valori sono keysym GDK in decimale: F13 65482, F14 65483, F15 65484, F16 65485, F17 65486.
[Version]
ConfigVersion=3.10

[C64SC]
KeySetEnable=1
KeySet1North=65482
KeySet1South=65483
KeySet1West=65484
KeySet1East=65485
KeySet1Fire=65486
