# Configurazione della toolchain C64 (toolchain/) per QUESTO progetto (13/11). La leggono gli script di toolchain/ (sh: variabili).
# Copyright (c) 2026 - Simone Caporale

# Variabili d'ambiente dell'host passate ai container da toolchain/run.sh, se impostate (oltre a EMU_URL, C64_VIEW, DISPLAY):
# release, compressione, menu dal disco e varianti di build dei test e degli strumenti VICE.
C64_PASS_ENV="RELEASE ZX0_BEST C64_REALMENU NOKEYS AUTOY TSV NOMUSIC TESTSELL TMDBG TB TESTLVL TESTCL TESTSP TESTX TESTY TESTUI
 TESTFIRE TESTSK TESTFZ TESTFZR TESTFZS TESTGOD LDCOL ERRLINES KRILL_ZP KRILL_INSTALL KRILL_RESIDENT KRILL_TRANSIENT"

# Immagini del progetto (oltre a quelle della toolchain) controllate da toolchain/validate_env.sh
C64_EXTRA_IMAGES="barbarian-manual"

# Disco proposto per primo nella pagina indice del viewer (nome o modello con *; il numero di versione piu' alto)
C64_VIEW_DISK="blood_path_v*_1541.d64"

# Zip di Krill's Loader da cui si compila cc1541 (toolchain/build.sh cc1541)
C64_KRILL_ZIP="src/third-party/krill/loader-v194.zip"
