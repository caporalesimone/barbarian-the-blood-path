# VirtualC64 headless + control API. It contains the ALREADY built headless page (c64-headless.html, generated by build.py)
# and only the files needed at run time (list in .dockerignore: allowlist). No portable/, build.py, changelog, etc.
# Do not run by hand: `python3 build.py` generates the pages and then builds the image, passing the pages folder as the
# context named "pages" (--build-context pages=DIR: so the --out output can also live outside this folder).
# Optional CA for a TLS-intercepting proxy (only during npm/playwright): --secret id=ca,src=FILE (build.py: C64_CA_BUNDLE).
# Copyright © 2026 Simone Caporale
FROM node:22-bookworm-slim
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NODE_PATH=/usr/local/lib/node_modules \
    C64_HOST=0.0.0.0 C64_NO_SANDBOX=1 \
    C64_ROMS=/roms C64_GAMES=/games
# external dependencies: ffmpeg (video) and Playwright + Chromium (used only internally by the daemon)
RUN --mount=type=secret,id=ca \
    if [ -s /run/secrets/ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    apt-get update && apt-get install -y --no-install-recommends ffmpeg \
 && npm i -g playwright@1.63.0 \
 && npx playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/* /root/.npm
WORKDIR /app
COPY --from=pages c64-headless.html /app/out/c64-headless.html
COPY headless/ /app/headless/
COPY docs/ /app/docs/
COPY roms/ /app/roms/
RUN mkdir -p /games /roms /scripts /output
# /games = game files (.d64 .g64 .prg .t64 .crt ...) ; /roms = extra ROMs ; /scripts = input scripts ; /output = produced files (screenshots, videos, recordings)
VOLUME ["/games", "/roms", "/scripts", "/output"]
EXPOSE 7064
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "require('http').get('http://127.0.0.1:7064/ping',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "headless/c64d.js", "--port", "7064"]
