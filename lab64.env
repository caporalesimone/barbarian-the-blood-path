# Configurazione di Lab64 (la toolchain C64, repository a parte dal 14/11) per QUESTO progetto (13/11).
# La leggono i comandi lab64 lanciati dalla cartella del progetto (sh: variabili). Il gioco non sa dove sta Lab64: usa il comando lab64.
# Copyright (c) 2026 - Simone Caporale

# (14/11) versione di Lab64 richiesta: i comandi lab64 si fermano se Lab64 ha una versione diversa
LAB64_VERSION="1.11"

# Variabili d'ambiente dell'host passate ai container di Lab64, se impostate (oltre a EMU_URL, C64_VIEW, DISPLAY):
# release, compressione, menu dal disco e varianti di build dei test e degli strumenti VICE.
C64_PASS_ENV="RELEASE CHEATS BUILD_ATLAS BUILD_MAPS ZX0_BEST C64_REALMENU NOKEYS AUTOY TSV NOMUSIC TESTSELL TMDBG TB TESTLVL TESTCL TESTSP TESTX TESTY TESTUI
 TESTFIRE TESTSK TESTFZ TESTFZR TESTFZS TESTGOD LDCOL ERRLINES KRILL_ZP KRILL_INSTALL KRILL_RESIDENT KRILL_TRANSIENT"

# Immagini del progetto (oltre a quelle di Lab64) controllate da lab64 check-env
C64_EXTRA_IMAGES=""

# Disco proposto per primo nella pagina indice del viewer (nome o modello con *; il numero di versione piu' alto).
# I dischi stanno in out/releases/v<versione>/ (14/11, tools/build/publish.py): l'indice del viewer li elenca tutti.
C64_VIEW_DISK="blood_path_v*_1541.d64"
# nome del progetto nella pagina del viewer
C64_VIEW_TITLE="Barbarian: The Blood Path"
# comando del viewer che apre un .d64 in VICE sullo schermo dal vivo (lettore del viewer di Lab64)
C64_VIEW_PLAYER="tools/vice/play.sh"


# (12/11, regola del committente) tetti di durata dei test (motore di Lab64): un test smoke / sanity, smoke da sola, smoke + sanity (s)
C64_TEST_CAPS="test=10 smoke=20 smoke+sanity=35"

# (14/11) lab64 build = build.sh del gioco (lab64 test usa il motore di Lab64 con tests/ del gioco)
C64_BUILD="./build.sh"
# (15/11) lab64 manual = il generatore del gioco (nel container lab64-pdf-gen: ritagli e dati, poi c64manual di Lab64) con il tema
# base "c64" di Lab64 + docs/manual/tema.css
C64_MANUAL="python3 tools/manual/gen_manual.py"
C64_MANUAL_THEME="docs/manual/tema.css"

# (15/11, TODO Z6) mappa della memoria (lab64 map): un PROGRAMMA = i file del disco che stanno in memoria insieme; i programmi si
# sostituiscono a vicenda, ognuno ha la sua mappa (out/work/memory-map/program-<nome>.html, indice in index.html).
# Il primo nome e' il file principale (quello che gira), poi i file che carica; nomi dei file del disco, con * ? [..].
C64_MAP_PROGRAM_BARBARIAN="barbarian"                 # loader con il menu (storia / manuale / gioco)
C64_MAP_PROGRAM_LORE="lore ldat title"                # titolo e storia
C64_MAP_PROGRAM_HELP="help"                           # il manuale a schermo
C64_MAP_PROGRAM_START="start game lobby hl"           # installa Krill, carica GAME (ZX0, sul posto), LOBBY e l'elenco eroi
C64_MAP_PROGRAM_GAME="game lobby menu? twn? gfx? bossch? fmap snd* hl ksave save-*"   # il gioco con moduli, dati e salvataggi
C64_MAP_PROGRAM_JUKEBOX="jukebox"                     # prova dei brani (i brani sono nel programma)
