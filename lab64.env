# Configurazione di Lab64 (la toolchain C64, repository a parte dal 14/11: ../lab64) per QUESTO progetto (13/11).
# La leggono gli script di Lab64 lanciati dalla cartella del progetto (sh: variabili).
# Copyright (c) 2026 - Simone Caporale

# Variabili d'ambiente dell'host passate ai container da run.sh di Lab64, se impostate (oltre a EMU_URL, C64_VIEW, DISPLAY):
# release, compressione, menu dal disco e varianti di build dei test e degli strumenti VICE.
C64_PASS_ENV="RELEASE BUILD_ATLAS BUILD_MAPS ZX0_BEST C64_REALMENU NOKEYS AUTOY TSV NOMUSIC TESTSELL TMDBG TB TESTLVL TESTCL TESTSP TESTX TESTY TESTUI
 TESTFIRE TESTSK TESTFZ TESTFZR TESTFZS TESTGOD LDCOL ERRLINES KRILL_ZP KRILL_INSTALL KRILL_RESIDENT KRILL_TRANSIENT"

# Immagini del progetto (oltre a quelle di Lab64) controllate da validate_env.sh di Lab64
C64_EXTRA_IMAGES="barbarian-manual"

# Disco proposto per primo nella pagina indice del viewer (nome o modello con *; il numero di versione piu' alto).
# I dischi stanno in out/releases/v<versione>/ (14/11, tools/build/publish.py): l'indice del viewer li elenca tutti.
C64_VIEW_DISK="blood_path_v*_1541.d64"
# nome del progetto nella pagina del viewer
C64_VIEW_TITLE="Barbarian: The Blood Path"
# comando del viewer che apre un .d64 in VICE sullo schermo dal vivo (viewer.sh e viewer_player.py di Lab64)
C64_VIEW_PLAYER="tools/vice/play.sh"

# Zip di Krill's Loader da cui si compila cc1541 (stage cc1541-build di docker/Dockerfile di Lab64; percorso relativo al progetto)
C64_KRILL_ZIP="src/third-party/krill/loader-v194.zip"
