# Lab64 configuration (the C64 toolchain, a separate repository since 14/11) for THIS project (13/11).
# Read by the lab64 commands run from the project folder (sh: variables). The game does not know where Lab64 lives: it uses the lab64 command.
# Copyright (c) 2026 - Simone Caporale

# (14/11) required Lab64 version: the lab64 commands stop if Lab64 has a different version
LAB64_VERSION="1.15"

# Host environment variables passed to the Lab64 containers, if set (besides EMU_URL, C64_VIEW, DISPLAY):
# release, compression, menu from disk, and build variants of the tests and the VICE tools.
C64_PASS_ENV="RELEASE CHEATS BUILD_ATLAS BUILD_MAPS ZX0_BEST C64_REALMENU NOKEYS AUTOY TSV NOMUSIC TESTSELL TMDBG TB TESTLVL TESTCL TESTSP TESTX TESTY TESTUI
 TESTFIRE TESTSK TESTFZ TESTFZR TESTFZS TESTGOD LDCOL ERRLINES KRILL_ZP KRILL_INSTALL KRILL_RESIDENT KRILL_TRANSIENT"

# Project images (besides those of Lab64) checked by lab64 check-env
C64_EXTRA_IMAGES=""

# Disk offered first in the viewer's index page (name or pattern with *; the highest version number).
# Disks live in out/releases/v<version>/ (14/11, tools/build/publish.py): the viewer's index lists them all.
C64_VIEW_DISK="blood_path_v*_1541.d64"
# project name in the viewer page
C64_VIEW_TITLE="Barbarian: The Blood Path"
# viewer command that opens a .d64 in VICE on the live screen (player of Lab64's viewer)
C64_VIEW_PLAYER="lab64 vice"


# (12/11, owner's rule) test duration caps (Lab64 engine): a single smoke / sanity test, smoke alone, smoke + sanity (s)
C64_TEST_CAPS="test=10 smoke=20 smoke+sanity=35"

# (14/11) lab64 build = the game's build.sh (lab64 test uses Lab64's engine with the game's tests/)
C64_BUILD="./build.sh"
# (15/11) lab64 manual = the game's generator (in the lab64-pdf-gen container: crops and data, then Lab64's c64manual) with Lab64's
# base "c64" theme + manual/tema.css
C64_MANUAL="python3 tools/manual/gen_manual.py"
C64_MANUAL_THEME="manual/tema.css"

# (15/11, TODO Z6) memory map (lab64 map): a PROGRAM = the disk files that sit in memory together; programs replace
# each other, each has its own map (out/work/memory-map/program-<name>.html, index in index.html).
# The first name is the main file (the one that runs), then the files it loads; disk file names, with * ? [..].
C64_MAP_PROGRAM_BARBARIAN="barbarian"                 # loader with the menu (story / manual / game)
C64_MAP_PROGRAM_LORE="lore ldat title"                # title and story
C64_MAP_PROGRAM_HELP="help"                           # the on-screen manual
C64_MAP_PROGRAM_START="start game lobby hl"           # installs Krill, loads GAME (ZX0, in place), LOBBY and the hero list
C64_MAP_PROGRAM_GAME="game lobby menu core csheet twn? gfx? fmap snd* hl ksave save-* qst* cheats"   # the game with modules, data and saves
C64_MAP_PROGRAM_JUKEBOX="jukebox"                     # track player (the tracks are in the program)
